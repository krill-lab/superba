[Desktop Entry]
Type=Application
Name=Superba
Comment=Switch Codex between model providers
Exec=superba %u
Icon=superba
Terminal=false
Categories=Development;Utility;
StartupWMClass=superba
Actions=launch-chatgpt;
MimeType=x-scheme-handler/superba;

[Desktop Action launch-chatgpt]
Name=Open ChatGPT with Superba
Name[zh_CN]=用 Superba 打开 ChatGPT
Exec=superba --launch-chatgpt
