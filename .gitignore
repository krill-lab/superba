# build output
/target/
/target-*/
**/*.rs.bk

# secrets and private notes: never commit (signing certs, passwords, internal endpoints, test keys)
/.secrets/
/.private/
*.p12
*.cer
*.pem
*.key
*.p8
*.pfx
*.keychain-db
*.env
!*.env.example

# local e2e artifacts
/e2e/out/
/e2e/.work/
__pycache__/

# editors / OS
.DS_Store
.idea/
.vscode/

# generated by cargo-about in the release workflow
/THIRD-PARTY-NOTICES.txt
