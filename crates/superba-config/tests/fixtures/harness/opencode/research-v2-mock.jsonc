{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "share": "disabled",
  "model": "krill-chat/mock-gpt",
  "providers": {
    "krill-chat": {
      "name": "Krill (Chat)",
      "package": "@opencode/ai/providers/openai-compatible",
      "env": ["MOCK_KEY"],
      "settings": { "baseURL": "http://127.0.0.1:18471/v1" },
      "models": { "mock-gpt": { "name": "Mock GPT", "limit": { "context": 400000, "output": 32000 } }, "hot-added": { "name": "Hot added" } }
    },
    "krill-resp": {
      "name": "Krill (Responses)",
      "package": "@opencode/ai/providers/openai",
      "settings": { "baseURL": "http://127.0.0.1:18471/v1", "apiKey": "{env:MOCK_KEY}" },
      "models": { "gpt-5.4-mini": { "name": "GPT-5.4 mini", "capabilities": { "reasoning": { "supported": true, "effort": ["low","medium","high","xhigh"] } },
                                    "limit": { "context": 400000, "output": 128000 } } }
    },
    "krill-anth": {
      "name": "Krill (Anthropic)",
      "package": "@opencode/ai/providers/anthropic-compatible",
      "settings": { "baseURL": "http://127.0.0.1:18471/v1", "authToken": "{env:MOCK_KEY}" },
      "models": { "mock-claude": { "name": "Mock Claude", "limit": { "context": 200000, "output": 64000 } } }
    }
  }
}
